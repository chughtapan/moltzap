{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "targets": {
    "format": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt ."
      }
    },
    "format:check": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt --check ."
      }
    },
    "docs:generate": {
      "cache": true,
      "inputs": [
        "docsGeneration"
      ],
      "outputs": [
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs",
        "{workspaceRoot}/packages/**/src/**/MODULE.md"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "pnpm exec typedoc",
          "pnpm exec tsx scripts/docs/generate-modules.ts",
          "pnpm exec tsx scripts/docs/generate-constants-snippets.ts"
        ]
      }
    },
    "docs:check:mermaid": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "pnpm exec puppeteer browsers install chrome-headless-shell",
          "pnpm exec tsx scripts/docs/check-mermaid.ts"
        ]
      }
    },
    "docs:check:no-hardcoded-constants": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsx scripts/docs/check-no-hardcoded-constants.ts"
      }
    },
    "docs:check:doc-imports-resolve": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsx scripts/docs/check-doc-imports-resolve.ts"
      }
    },
    "simulator-controller-image": {
      "cache": false,
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/scripts/simulator/controller-image/host-command.json"
      ],
      "options": {
        "cwd": ".",
        "command": "node scripts/simulator/build-controller-image.mjs"
      }
    },
    "openclaw-agent-image": {
      "cache": false,
      "dependsOn": [
        "agent-images-check"
      ],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/scripts/agent-images/openclaw/Dockerfile",
        "{workspaceRoot}/scripts/agent-images/openclaw/host-command.json"
      ],
      "options": {
        "cwd": ".",
        "command": "node scripts/agent-images/build-openclaw-image.mjs"
      }
    },
    "nanoclaw-agent-image": {
      "cache": false,
      "dependsOn": [
        "agent-images-check"
      ],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/scripts/agent-images/nanoclaw/Dockerfile",
        "{workspaceRoot}/scripts/agent-images/nanoclaw/host-command.json"
      ],
      "options": {
        "cwd": ".",
        "command": "node scripts/agent-images/build-nanoclaw-image.mjs"
      }
    },
    "agent-images-check": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/agent-images/**/*",
        "{workspaceRoot}/packages/nanoclaw-channel/src/channels/moltzap.ts"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "node --test scripts/agent-images/shared/entrypoint.test.mjs scripts/agent-images/shared/register-daemon.test.mjs scripts/agent-images/nanoclaw/process-driver.test.mjs",
          "node --check scripts/agent-images/build-openclaw-image.mjs",
          "node --check scripts/agent-images/build-nanoclaw-image.mjs",
          "node --check scripts/agent-images/shared/entrypoint.mjs",
          "node --check scripts/agent-images/shared/register-daemon.mjs",
          "node --check scripts/agent-images/nanoclaw/entrypoint.mjs",
          "node --check scripts/agent-images/nanoclaw/preload.mjs",
          "node --check scripts/agent-images/nanoclaw/prepare.mjs",
          "node --check scripts/agent-images/nanoclaw/process-driver.mjs",
          "node --check scripts/agent-images/nanoclaw/provision.mjs",
          "node --check scripts/test/nanoclaw-addressed-send-probe.mjs"
        ]
      }
    },
    "simulator-local-fault-qualification": {
      "cache": false,
      "dependsOn": [
        "simulator-local-fault-qualification-check",
        {
          "projects": [
            "@moltzap/simulator"
          ],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/scripts/test/simulator-fault-end-to-end.mjs",
        "{workspaceRoot}/scripts/test/simulator-fault-program.mjs",
        "{workspaceRoot}/scripts/test/simulator-local-fault-qualification.mjs",
        "{workspaceRoot}/scripts/simulator/build-controller-image.mjs",
        "{workspaceRoot}/scripts/simulator/controller-image/Dockerfile",
        "{workspaceRoot}/packages/simulator/local/**/*",
        "{workspaceRoot}/packages/simulator/scripts/local-create-cluster.mjs"
      ],
      "options": {
        "cwd": ".",
        "command": "node scripts/test/simulator-local-fault-qualification.mjs"
      }
    },
    "simulator-local-fault-qualification-check": {
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "@moltzap/simulator"
          ],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/scripts/simulator/build-controller-image.mjs",
        "{workspaceRoot}/scripts/test/simulator-fault-end-to-end.mjs",
        "{workspaceRoot}/scripts/test/simulator-fault-program.mjs",
        "{workspaceRoot}/scripts/test/simulator-fault-program.test.mjs",
        "{workspaceRoot}/scripts/test/simulator-local-fault-qualification.mjs",
        "{workspaceRoot}/scripts/test/simulator-local-fault-qualification.test.mjs",
        "{workspaceRoot}/scripts/test/simulator-workspace-loader.mjs"
      ],
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "node --test scripts/test/simulator-fault-program.test.mjs scripts/test/simulator-local-fault-qualification.test.mjs",
          "node --check scripts/test/simulator-fault-end-to-end.mjs",
          "node --check scripts/test/simulator-fault-program.mjs",
          "node --check scripts/test/simulator-local-fault-qualification.mjs",
          "node --check scripts/test/simulator-workspace-loader.mjs",
          "node --check scripts/simulator/build-controller-image.mjs"
        ]
      }
    },
    "arch:config:generate": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/architecture/gen-configs.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/packages/*/safer-architecture.config.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/architecture/gen-configs.mjs"
      }
    },
    "arch:config:check": {
      "cache": false,
      "dependsOn": [
        "arch:config:generate"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "test -z \"$(git ls-files --others --exclude-standard -- 'packages/*/safer-architecture.config.json')\" && git diff --exit-code -- 'packages/*/safer-architecture.config.json'"
      }
    },
    "lint:architecture-boundaries": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/architecture/check-boundaries.js"
      }
    },
    "lint:typescript": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tsconfig.eslint.json",
          "tsc --noEmit -p scripts/docs/tsconfig.json"
        ]
      }
    },
    "lint:effect": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/code/effect-diagnostics.mjs"
      }
    },
    "lint:dead-code": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "agent-code-guard-knip --treat-config-hints-as-errors"
      }
    },
    "lint:eslint": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.shared.mjs",
        "{workspaceRoot}/tsconfig.eslint.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/*.ts",
        "{workspaceRoot}/examples/**/*.ts"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "eslint eslint.config.mjs eslint.shared.mjs '*.ts' 'examples/**/*.ts' --no-error-on-unmatched-pattern --cache --max-warnings=0"
      }
    },
    "lint:oxlint": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxlint . --deny-warnings"
      }
    },
    "lint:sloppy-code-guard": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "./scripts/code/sloppy-code-guard.sh"
      }
    },
    "lint:script-reachability": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsx scripts/repo/check-script-reachability.ts"
      }
    },
    "lint:root": {
      "cache": false,
      "dependsOn": [
        "lint:typescript",
        "lint:dead-code",
        "lint:eslint"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint": {
      "cache": false,
      "dependsOn": [
        "lint:architecture-boundaries",
        "arch:config:check",
        "lint:root",
        "lint:effect",
        "lint:oxlint",
        "lint:sloppy-code-guard",
        "lint:script-reachability",
        "lint:adr-shape",
        "lint:agent-files",
        {
          "target": "arch:check",
          "projects": "@moltzap/*"
        },
        {
          "target": "lint",
          "projects": "@moltzap/*"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint:adr-shape": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsx scripts/docs/adr/check-shape.ts"
      }
    },
    "lint:agent-files": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsx scripts/repo/check-agent-files.ts"
      }
    },
    "test": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/docs/**/*.ts",
        "{workspaceRoot}/scripts/docs/mermaid-puppeteer.json",
        "{workspaceRoot}/scripts/docs/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec vitest run --config scripts/docs/vitest.config.ts"
      }
    },
    "test:integration": {
      "cache": false,
      "inputs": [
        "workspaceFiles"
      ],
      "dependsOn": [
        "nanoclaw-agent-image",
        {
          "projects": [
            "@moltzap/identity",
            "@moltzap/router",
            "@moltzap/client",
            "@moltzap/openclaw-channel",
            "@moltzap/nanoclaw-channel"
          ],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "pnpm exec tsc -p scripts/test/tsconfig.adapter-daemon.json",
          "pnpm exec vitest run --config scripts/test/adapter-daemon-vitest.config.ts"
        ]
      }
    }
  }
}

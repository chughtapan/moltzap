{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "vitest.workspace-aliases.ts",
        "scripts/architecture/check-package.ts",
        "scripts/build/*.ts",
        "scripts/code/*.ts",
        "scripts/setup/*.ts",
        "scripts/test-*-package.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/generate-constants-snippets.ts",
        "scripts/docs/generate-modules.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts"
      ],
      "project": [
        "*.ts",
        "scripts/docs/**/*.ts",
        "scripts/architecture/**/*.ts",
        "scripts/build/**/*.ts",
        "scripts/code/**/*.ts",
        "scripts/setup/**/*.ts",
        "scripts/test/packed-workspace.ts",
        "scripts/test-*-package.ts"
      ],
      "ignoreDependencies": [
        "@effect/tsgo",
        "@mermaid-js/mermaid-cli",
        "oxlint",
        "puppeteer"
      ]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/nanoclaw-channel": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/identity": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    }
  },
  "ignoreIssues": {
    "packages/client/src/transport/messaging/runtime/index.ts": [
      "types"
    ],
    "packages/client/src/transport/messaging/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/transport/wire/schemas.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/verification.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/store/index.ts": [
      "types"
    ],
    "packages/client/src/store/database/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/store/database/schema.ts": [
      "types"
    ],
    "packages/client/src/store/rows/index.ts": [
      "exports"
    ],
    "packages/client/src/endpoint/mcp/owner-tools.ts": [
      "exports"
    ]
  }
}

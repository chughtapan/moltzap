{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eslint.shared.mjs",
        "vitest.workspace-aliases.ts",
        "scripts/docs/adr/check-shape.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/generate-constants-snippets.ts",
        "scripts/docs/generate-modules.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts"
      ],
      "project": ["*.mjs", "*.ts", "scripts/docs/**/*.ts"],
      "ignoreDependencies": ["@mermaid-js/mermaid-cli", "puppeteer"]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/nanoclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/protocol": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/evals": {
      "entry": [
        "src/cli.ts",
        "src/execution.ts",
        "src/peer-application.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs"]
    },
    "packages/simulator": {
      "entry": [
        "src/cluster/controller/services.ts",
        "src/cluster/controller/main.ts",
        "src/cluster/profiles/gke.ts",
        "src/cluster/profiles/local.ts",
        "src/cluster/temporal.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs", "vitest*.config.mjs"],
      "ignoreDependencies": ["@moltzap/server-core"]
    },
    "packages/server": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/identity": {
      "entry": [
        "src/registry/process.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs"],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "packages/router": {
      "entry": [
        "src/router/process.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs"]
    }
  }
}

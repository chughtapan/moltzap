{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.shared.mjs", "vitest.workspace-aliases.ts"],
      "project": ["*.mjs", "*.ts"],
      "ignoreDependencies": ["@mermaid-js/mermaid-cli", "typedoc"]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.integration.test.ts",
        "src/**/*.types-check.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.ts"]
    },
    "packages/nanoclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.ts"]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.integration.test.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.ts"]
    },
    "packages/protocol": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "src/testing/conformance/**/*.ts",
        "scripts/check-mermaid.ts",
        "vitest*.config.ts"
      ],
      "project": ["scripts/**/*.ts", "src/**/*.ts", "*.mjs", "vitest*.config.ts"]
    },
    "packages/evals": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts", "*.mjs"]
    },
    "packages/simulator": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.integration.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs", "vitest*.config.ts"],
      "ignoreDependencies": ["@moltzap/server-core"]
    },
    "packages/server": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.integration.test.ts",
        "src/**/*.types-check.ts",
        "src/**/__tests__/**/*.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.ts"]
    }
  }
}

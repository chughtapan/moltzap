{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eslint.shared.mjs",
        "vitest.workspace-aliases.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/generate-constants-snippets.ts",
        "scripts/docs/generate-modules.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts"
      ],
      "project": [
        "*.mjs",
        "*.ts",
        "scripts/docs/**/*.ts"
      ],
      "ignoreDependencies": [
        "@effect/tsgo",
        "@mermaid-js/mermaid-cli",
        "oxlint",
        "puppeteer"
      ]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs",
        "vitest*.config.mjs"
      ]
    },
    "packages/nanoclaw-channel": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/openclaw-channel": {
      "entry": ["src/**/*.test.ts", "vitest*.config.mjs"],
      "project": [
        "src/**/*.ts",
        "*.mjs",
        "vitest*.config.mjs"
      ]
    },
    "packages/identity": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ]
    }
  },
  "ignoreIssues": {
    "packages/client/src/transport/messaging/types.ts": [
      "types"
    ],
    "packages/client/src/transport/messaging/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/transport/wire/canonical.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/codec.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/schemas.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/verification.ts": [
      "exports"
    ],
    "packages/client/src/transport/wire/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/transport/history/index.ts": [
      "types"
    ],
    "packages/client/src/transport/history/database/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/transport/history/database/schema.ts": [
      "types"
    ],
    "packages/client/src/transport/history/rows/index.ts": [
      "exports"
    ],
    "packages/client/src/endpoint/mcp/owner-tools.ts": [
      "exports"
    ]
  }
}

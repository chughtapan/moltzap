{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eslint.shared.mjs",
        "vitest.workspace-aliases.ts",
        "scripts/docs/adr/check-shape.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/generate-constants-snippets.ts",
        "scripts/docs/generate-modules.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts"
      ],
      "project": ["*.mjs", "*.ts", "scripts/docs/**/*.ts"],
      "ignoreDependencies": [
        "@effect/tsgo",
        "@mermaid-js/mermaid-cli",
        "oxlint",
        "puppeteer"
      ]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/nanoclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs", "vitest*.config.mjs"]
    },
    "packages/evals": {
      "entry": [
        "src/cli.ts",
        "src/execution.ts",
        "src/peer-application.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts"
      ],
      "project": ["src/**/*.ts", "*.mjs"]
    },
    "packages/simulator": {
      "entry": [
        "src/cluster/controller/services.ts",
        "src/cluster/controller/main.ts",
        "src/cluster/profiles/gke.ts",
        "src/cluster/profiles/local.ts",
        "src/cluster/temporal.ts",
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs", "vitest*.config.mjs"],
      "ignoreDependencies": ["@types/ws"]
    },
    "packages/identity": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs"],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.mjs"
      ],
      "project": ["src/**/*.ts", "*.mjs"]
    }
  },
  "ignoreIssues": {
    "packages/client/src/endpoint/engine-types.ts": ["types"],
    "packages/client/src/endpoint/engine.ts": ["exports", "types"],
    "packages/client/src/endpoint/representation-canonical.ts": ["exports"],
    "packages/client/src/endpoint/representation-codec.ts": ["exports"],
    "packages/client/src/endpoint/representation-schemas.ts": ["exports"],
    "packages/client/src/endpoint/representation-verification.ts": [
      "exports"
    ],
    "packages/client/src/endpoint/representation.ts": ["exports", "types"],
    "packages/client/src/endpoint/store.ts": ["types"],
    "packages/client/src/endpoint/store/database/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/endpoint/store/database/schema.ts": ["types"],
    "packages/client/src/endpoint/store/rows/index.ts": ["exports"],
    "packages/client/src/management-runtime.ts": ["exports"]
  }
}

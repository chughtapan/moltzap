{
  "name": "@moltzap/v2-harness",
  "version": "2026.729.1",
  "private": true,
  "description": "Interpretive protocol engine, local state, HarnessClient, and moltzapd MCP boundary",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "moltzapd": "./bin/moltzapd"
  },
  "scripts": {
    "build": "nx run @moltzap/v2-harness:build",
    "lint": "nx run @moltzap/v2-harness:lint"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/harness",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/harness",
          "command": "eslint . --cache --max-warnings=0"
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/v2-identity": "workspace:*",
    "@moltzap/v2-transcript": "workspace:*",
    "@moltzap/v2-router": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

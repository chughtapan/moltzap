{
  "name": "@moltzap/v2-router",
  "version": "2026.729.1",
  "private": true,
  "description": "Router contracts and representation, Router client and in-memory server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "moltzap-router": "./bin/moltzap-router"
  },
  "scripts": {
    "build": "nx run @moltzap/v2-router:build",
    "typecheck": "nx run @moltzap/v2-router:typecheck",
    "typecheck:tests": "nx run @moltzap/v2-router:typecheck:tests",
    "test": "nx run @moltzap/v2-router:test",
    "test:integration": "nx run @moltzap/v2-router:test:integration",
    "lint": "nx run @moltzap/v2-router:lint",
    "arch:check": "nx run @moltzap/v2-router:arch:check"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "v2Production",
          "^v2Production"
        ],
        "options": {
          "cwd": "v2/router",
          "command": "tsc -b"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "inputs": [
          "v2Production",
          "^v2Production"
        ],
        "options": {
          "cwd": "v2/router",
          "command": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo -p tsconfig.json"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/router",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "v2/router",
          "command": "vitest run --config vitest.config.mjs"
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "v2/router",
          "command": "vitest run --config vitest.integration.config.mjs"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/router",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/router",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/v2-identity": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5.7.0",
    "vitest": "3.2.4"
  }
}

{
  "name": "@moltzap/v2-identity",
  "version": "2026.729.0",
  "private": true,
  "description": "L1 models, cards, identifiers, signing/request-auth profiles, Registry client and PostgreSQL server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "moltzap-directory": "./bin/moltzap-directory"
  },
  "scripts": {
    "build": "nx run @moltzap/v2-identity:build",
    "lint": "nx run @moltzap/v2-identity:lint"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/identity",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/identity",
          "command": "eslint src --cache --max-warnings=0"
        }
      }
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5.7.0"
  }
}

{
  "name": "@moltzap/v2-simulator",
  "version": "2026.729.1",
  "private": true,
  "description": "Portable code-first kernel, runtime roster, closed event catalog, run-evidence store, public StackProvider contract",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/v2-simulator:build",
    "lint": "nx run @moltzap/v2-simulator:lint"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/simulator",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/simulator",
          "command": "eslint . --cache --max-warnings=0"
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/v2-harness": "workspace:*",
    "@moltzap/v2-identity": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

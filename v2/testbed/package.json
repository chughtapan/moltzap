{
  "name": "@moltzap/v2-testbed",
  "version": "2026.729.1",
  "private": true,
  "description": "StackProvider Live Layer, platform acquisition, process supervision, fault layers, substitutes, external-runtime constructors, black-box subjects",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/v2-testbed:build",
    "lint": "nx run @moltzap/v2-testbed:lint"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/testbed",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "v2/testbed",
          "command": "eslint . --cache --max-warnings=0"
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/v2-endpoint": "workspace:*",
    "@moltzap/v2-identity": "workspace:*",
    "@moltzap/v2-simulator": "workspace:*",
    "@moltzap/v2-transcript": "workspace:*",
    "@moltzap/v2-router": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

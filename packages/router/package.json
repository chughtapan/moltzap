{
  "name": "@moltzap/router",
  "version": "2026.1021.2",
  "description": "Router contracts and representation, Router client and in-memory server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/chughtapan/moltzap/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/chughtapan/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "sharness-router": "./bin/sharness-router"
  },
  "scripts": {
    "build": "nx run @moltzap/router:build",
    "typecheck": "nx run @moltzap/router:typecheck",
    "typecheck:tests": "nx run @moltzap/router:typecheck:tests",
    "test": "nx run @moltzap/router:test",
    "test:integration": "nx run @moltzap/router:test:integration",
    "lint": "nx run @moltzap/router:lint",
    "arch:check": "nx run @moltzap/router:arch:check"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ],
        "options": {
          "cwd": "packages/router",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/router",
          "command": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo -p tsconfig.json"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/router",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/router",
          "command": "vitest run --config vitest.config.ts"
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/router",
          "command": "vitest run --config vitest.integration.config.ts"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/router",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/router",
          "command": "node ../../scripts/architecture/check-package.ts ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/rpc": "catalog:",
    "@moltzap/identity": "workspace:*",
    "canonicalize": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sharnessContentHash": "sha256:c38d58612b5a001909882e8aab4355e268c41891f59ab843e01739a1e7ae43b6"
}

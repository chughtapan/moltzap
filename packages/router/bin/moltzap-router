#!/usr/bin/env node
import { NodeRuntime } from "@effect/platform-node";
import { ConfigProvider, Console, Effect, Layer } from "effect";
import { RouterServer } from "../dist/server.js";
import { processHelp } from "../dist/router.js";

const program = process.argv.includes("--help")
  ? Console.log(processHelp)
  : Layer.launch(RouterServer.layer);

program.pipe(
  Effect.catchAll((error) =>
    Console.error(error.message).pipe(
      Effect.andThen(Effect.sync(() => {
        process.exitCode = 1;
      })),
    ),
  ),
  Effect.withConfigProvider(ConfigProvider.fromEnv()),
  NodeRuntime.runMain,
);

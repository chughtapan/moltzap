{
  "name": "@moltzap/nanoclaw-channel",
  "version": "2026.811.0",
  "description": "NanoClaw channel adapter for MoltZap messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/channels/moltzap.js",
  "types": "./dist/channels/moltzap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/moltzap.d.ts",
      "import": "./dist/channels/moltzap.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/nanoclaw-channel:build",
    "lint": "nx run @moltzap/nanoclaw-channel:lint"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-nanoclaw-package.mjs"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "node ../../scripts/architecture/check-package.mjs ."
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "@types/node": "^25.5.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

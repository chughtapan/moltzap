{
  "name": "@moltzap/nanoclaw-channel",
  "version": "0.0.0",
  "description": "Nanoclaw channel for MoltZap \u2014 smoke test package, not published",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chughtapan/moltzap"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/channels/moltzap.js",
  "types": "./dist/channels/moltzap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/moltzap.d.ts",
      "import": "./dist/channels/moltzap.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/nanoclaw-channel:build",
    "lint": "nx run @moltzap/nanoclaw-channel:lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:conformance": "vitest run -c vitest.conformance.config.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "@moltzap/protocol": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@effect/vitest": "^0.30.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  }
}

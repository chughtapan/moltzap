{
  "name": "@moltzap/nanoclaw-channel",
  "version": "0.0.0",
  "description": "Nanoclaw channel for MoltZap \u2014 smoke test package, not published",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chughtapan/moltzap"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/channels/moltzap.js",
  "types": "./dist/channels/moltzap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/moltzap.d.ts",
      "import": "./dist/channels/moltzap.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src *.ts --cache --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:conformance": "vitest run -c vitest.conformance.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "@moltzap/protocol": "workspace:*",
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/vitest": "^0.29.0",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

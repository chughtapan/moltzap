{
  "name": "@moltzap/nanoclaw-channel",
  "version": "0.0.0",
  "description": "NanoClaw channel adapter for MoltZap \u2014 private package",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chughtapan/moltzap"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/channels/moltzap.js",
  "types": "./dist/channels/moltzap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/moltzap.d.ts",
      "import": "./dist/channels/moltzap.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/nanoclaw-channel:build",
    "lint": "nx run @moltzap/nanoclaw-channel:lint",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/nanoclaw-channel",
          "command": "node ../../scripts/architecture/check-package.mjs ."
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  }
}

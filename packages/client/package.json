{
  "name": "@moltzap/client",
  "version": "2026.1021.0",
  "description": "Social Harness endpoint runtime and harness boundary",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/chughtapan/moltzap/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/chughtapan/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    }
  },
  "bin": {
    "sharnessd": "./bin/sharnessd"
  },
  "scripts": {
    "build": "nx run @moltzap/client:build",
    "lint": "nx run @moltzap/client:lint",
    "test": "vitest run",
    "test:integration": "nx run @moltzap/client:test:integration",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "inputs": [
          "sources",
          "^production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          {
            "runtime": "node --version"
          }
        ],
        "options": {
          "cwd": "packages/client",
          "command": "tsc -p tsconfig.integration.json && vitest run --config vitest.integration.config.ts"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-client-package.ts"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "node ../../scripts/architecture/check-package.ts ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@moltzap/identity": "workspace:*",
    "@moltzap/router": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "canonicalize": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "protobufjs": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:"
  }
}

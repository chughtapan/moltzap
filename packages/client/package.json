{
  "name": "@moltzap/client",
  "version": "2026.529.0",
  "description": "MoltZap client service \u2014 connection, conversation state, and cross-conversation context",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "moltzap": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "import": "./dist/test-utils/index.js"
    },
    "./channel-base": {
      "types": "./dist/channel-base/index.d.ts",
      "import": "./dist/channel-base/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src *.ts --cache --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:conformance": "vitest run -c vitest.conformance.config.ts",
    "docs:generate": "tsc -b && pnpm exec tsx scripts/generate-cli-docs.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "0.49.0",
    "@effect/printer-ansi": "0.49.0",
    "@effect/rpc": "0.75.1",
    "@effect/typeclass": "0.40.0",
    "@moltzap/protocol": "workspace:*",
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@moltzap/server-core": "workspace:*",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@moltzap/server-core",
  "version": "2026.520.1",
  "description": "Building blocks for agent-to-agent messaging — services, RPC, WebSocket, encryption",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "files": [
    "dist",
    "bin",
    "src/app/core-schema.sql"
  ],
  "bin": {
    "moltzap-server": "bin/moltzap-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-utils": {
      "import": "./dist/test-utils/index.js",
      "types": "./dist/test-utils/index.d.ts"
    },
    "./transport": {
      "import": "./dist/transport/index.js",
      "types": "./dist/transport/index.d.ts"
    },
    "./identity": {
      "import": "./dist/identity/index.js",
      "types": "./dist/identity/index.d.ts"
    },
    "./network": {
      "import": "./dist/network/index.js",
      "types": "./dist/network/index.d.ts"
    },
    "./task": {
      "import": "./dist/task/index.js",
      "types": "./dist/task/index.d.ts"
    },
    "./app": {
      "import": "./dist/app/index.js",
      "types": "./dist/app/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm --filter @moltzap/protocol build && tsc",
    "lint": "agent-code-guard-knip --treat-config-hints-as-errors && eslint src *.ts --cache --max-warnings=0",
    "typecheck:layers": "tsc -p src/network && tsc -p src/task",
    "dev": "tsx watch src/app/dev.ts",
    "db:generate": "kysely-codegen --out-file src/db/database.generated.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:conformance": "bash ../protocol/scripts/check-divergence-proofs.sh && vitest run -c vitest.conformance.config.ts",
    "test:conformance:proofs": "vitest run -c vitest.conformance.config.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/sql": "^0.51.0",
    "@effect/sql-kysely": "^0.47.0",
    "@electric-sql/pglite": "^0.4.4",
    "@moltzap/protocol": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "effect": "3.21.2",
    "kysely": "^0.28.2",
    "kysely-pglite": "^0.6.1",
    "pg": "^8.12.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "fast-check": "^4.0.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

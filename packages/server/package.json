{
  "name": "@moltzap/server-core",
  "version": "2026.811.0",
  "description": "Building blocks for agent-to-agent messaging - services, RPC, WebSocket, encryption",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "files": [
    "dist",
    "bin",
    "src/db/core-schema.sql"
  ],
  "bin": {
    "moltzap-server": "bin/moltzap-server"
  },
  "type": "module",
  "scripts": {
    "build": "nx run @moltzap/server-core:build",
    "lint": "nx run @moltzap/server-core:lint",
    "lint:effect": "nx run @moltzap/server-core:lint:effect",
    "dev": "tsx watch src/standalone.ts",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/server",
          "parallel": false,
          "commands": [
            "node scripts/clean-dist.mjs && tsc -b",
            "tsc-alias -p tsconfig.json"
          ]
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/server",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "lint:effect": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "options": {
          "cwd": "packages/server",
          "command": "effect-tsgo diagnostics --project tsconfig.json"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/server",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@effect/rpc": "^0.76.0",
    "@effect/sql": "^0.52.0",
    "@effect/sql-kysely": "^0.48.0",
    "@electric-sql/pglite": "^0.4.4",
    "@moltzap/protocol": "workspace:*",
    "effect": "^3.22.0",
    "kysely": "^0.28.2",
    "kysely-pglite": "^0.6.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "fast-check": "^3.23.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "#core": [
        "./src/core/index.ts"
      ],
      "#socket": [
        "./src/socket/index.ts"
      ],
      "#http": [
        "./src/http/index.ts"
      ],
      "#config": [
        "./src/config.ts"
      ],
      "#config/secrets": [
        "./src/config/secrets.ts"
      ],
      "#db": [
        "./src/db/barrel.ts"
      ],
      "#identity/agents": [
        "./src/identity/agents/index.ts"
      ],
      "#identity/credential-keys": [
        "./src/identity/credential-keys.ts"
      ],
      "#network": [
        "./src/network/index.ts"
      ],
      "#conversation": [
        "./src/conversation/index.ts"
      ],
      "#conversation/handlers": [
        "./src/conversation/handlers.ts"
      ],
      "#conversation/requirements": [
        "./src/conversation/requirements/index.ts"
      ],
      "#message": [
        "./src/message/index.ts"
      ],
      "#message/handlers": [
        "./src/message/handlers.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/__tests__"
  ],
  "references": [
    {
      "path": "../protocol"
    }
  ]
}

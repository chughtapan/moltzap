{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "customConditions": [
      "sharness-internal",
      "sharness-test"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.types-check.ts",
    "src/**/__tests__",
    "dist"
  ],
  "references": [
    {
      "path": "../identity"
    }
  ]
}

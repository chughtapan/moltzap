{
  "name": "@moltzap/claude-code-channel",
  "version": "0.1.0",
  "description": "Claude Code channel plugin for MoltZap messaging (conforms to Anthropic's official channel contract)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chughtapan/moltzap"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "moltzap-claude-code-channel": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./test-support": {
      "import": "./dist/test-support.js",
      "types": "./dist/test-support.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src *.ts --cache --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:conformance": "bash ../protocol/scripts/check-divergence-proofs.sh && vitest run -c vitest.conformance.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@moltzap/client": "workspace:*",
    "@moltzap/protocol": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/vitest": "^0.29.0",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

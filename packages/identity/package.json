{
  "name": "@moltzap/identity",
  "version": "2026.1020.1",
  "description": "Identity contracts and representation, AuthenticatedHttp, Registry client and PostgreSQL server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/chughtapan/moltzap/tree/main/packages/identity#readme",
  "bugs": {
    "url": "https://github.com/chughtapan/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./registry/server": {
      "types": "./dist/registry/server.d.ts",
      "import": "./dist/registry/server.js"
    },
    "./test": {
      "sharness-test": {
        "types": "./dist/wire-versions.d.ts",
        "import": "./dist/wire-versions.js"
      }
    }
  },
  "bin": {
    "sharness-registry": "./bin/sharness-registry"
  },
  "scripts": {
    "build": "nx run @moltzap/identity:build",
    "typecheck": "nx run @moltzap/identity:typecheck",
    "typecheck:tests": "nx run @moltzap/identity:typecheck:tests",
    "test": "nx run @moltzap/identity:test",
    "test:integration": "nx run @moltzap/identity:test:integration",
    "lint": "nx run @moltzap/identity:lint",
    "arch:check": "nx run @moltzap/identity:arch:check"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo -p tsconfig.json"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "vitest run --config vitest.config.ts"
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "vitest run --config vitest.integration.config.ts"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "node ../../scripts/architecture/check-package.ts ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/rpc": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@noble/curves": "catalog:",
    "canonicalize": "catalog:",
    "effect": "catalog:",
    "http-message-signatures": "catalog:",
    "jose": "catalog:",
    "structured-headers": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sharnessWireVersion": "2026.1020.2"
}

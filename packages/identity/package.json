{
  "name": "@moltzap/identity",
  "version": "2026.811.0",
  "description": "Identity contracts and representation, AuthenticatedHttp, Registry client and PostgreSQL server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./registry/server": {
      "types": "./dist/registry/server.d.ts",
      "import": "./dist/registry/server.js"
    }
  },
  "bin": {
    "moltzap-registry": "./bin/moltzap-registry"
  },
  "scripts": {
    "build": "nx run @moltzap/identity:build",
    "typecheck": "nx run @moltzap/identity:typecheck",
    "typecheck:tests": "nx run @moltzap/identity:typecheck:tests",
    "test": "nx run @moltzap/identity:test",
    "test:integration": "nx run @moltzap/identity:test:integration",
    "lint": "nx run @moltzap/identity:lint",
    "arch:check": "nx run @moltzap/identity:arch:check"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "tsc -b"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo -p tsconfig.json"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "vitest run --config vitest.config.mjs"
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/identity",
          "command": "vitest run --config vitest.integration.config.mjs"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/identity",
          "command": "node ../../scripts/architecture/check-package.mjs ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/experimental": "^0.61.0",
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@effect/rpc": "^0.76.0",
    "@effect/sql": "^0.52.0",
    "@effect/sql-pg": "^0.53.0",
    "canonicalize": "3.0.0",
    "effect": "^3.22.0",
    "http-message-signatures": "1.0.6",
    "jose": "6.2.5",
    "structured-headers": "2.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@electric-sql/pglite": "0.4.4",
    "@electric-sql/pglite-socket": "0.1.4",
    "@testcontainers/postgresql": "10.28.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "fast-check": "3.23.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "3.2.4"
  }
}

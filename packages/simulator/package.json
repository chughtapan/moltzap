{
  "name": "@moltzap/simulator",
  "version": "2026.811.0",
  "description": "Code-first lifecycle simulator for agentic societies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "gke/profile.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.types-check.ts",
    "!src/**/__tests__/**",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "moltzap-sim": "./bin/moltzap-sim"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/simulator:build",
    "lint": "nx run @moltzap/simulator:lint",
    "test": "vitest run --passWithNoTests",
    "local:profile:check": "nx run @moltzap/simulator:local-profile-check",
    "local:cluster:create": "nx run @moltzap/simulator:local-cluster-create",
    "local:run": "nx run @moltzap/simulator:local-run",
    "local:cluster:test": "nx run @moltzap/simulator:local-cluster-test",
    "gke:profile:check": "nx run @moltzap/simulator:gke-profile-check",
    "gke:terraform:check": "nx run @moltzap/simulator:gke-terraform-check",
    "gke:run": "nx run @moltzap/simulator:gke-run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/simulator",
          "command": "node scripts/clean-dist.mjs && tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "eslint . --cache --concurrency 4 --max-warnings=0"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "vitest run"
        },
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "local-profile-check": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "{projectRoot}/local/**/*",
          "{projectRoot}/scripts/local-create-cluster.mjs"
        ],
        "options": {
          "cwd": "packages/simulator",
          "command": "node --test local/profile.test.mjs && node --check scripts/local-create-cluster.mjs && node --check local/end-to-end.mjs"
        }
      },
      "local-cluster-create": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "node scripts/local-create-cluster.mjs"
        }
      },
      "local-run": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "node bin/moltzap-sim run --profile local"
        }
      },
      "local-cluster-test": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "vitest run --config vitest.cluster.config.mjs"
        }
      },
      "gke-profile-check": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "{projectRoot}/gke/**/*"
        ],
        "options": {
          "cwd": "packages/simulator",
          "command": "node --test gke/profile.test.mjs && bash -n gke/install-addons.sh && bash -n gke/cluster.sh && node --check dist/cluster/profiles/gke.js && node --check bin/moltzap-sim"
        }
      },
      "gke-terraform-check": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/gke/terraform/**/*",
          "{projectRoot}/gke/terraform-check.sh",
          {
            "runtime": "terraform version 2>/dev/null || echo none"
          }
        ],
        "options": {
          "cwd": "packages/simulator",
          "command": "bash gke/terraform-check.sh"
        }
      },
      "gke-run": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "node bin/moltzap-sim run --profile gke"
        }
      },
      "typecheck:tests": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test/simulator-packages.mjs"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/simulator",
          "command": "node ../../scripts/architecture/check-package.mjs ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@effect/sql": "^0.52.0",
    "@kubernetes/client-node": "1.4.0",
    "@moltzap/client": "workspace:*",
    "@moltzap/identity": "workspace:*",
    "@moltzap/router": "workspace:*",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "canonicalize": "3.0.0",
    "effect": "^3.22.0",
    "openclaw": "2026.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  }
}

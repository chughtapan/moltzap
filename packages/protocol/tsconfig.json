{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "#transport": [
        "transport/index.ts"
      ],
      "#identity": [
        "identity/index.ts"
      ],
      "#identity/agents": [
        "identity/agents/index.ts"
      ],
      "#identity/apps": [
        "identity/apps/index.ts"
      ],
      "#identity/users": [
        "identity/users/index.ts"
      ],
      "#identity/contacts": [
        "identity/contacts/index.ts"
      ],
      "#network": [
        "network/index.ts"
      ],
      "#task": [
        "task/index.ts"
      ],
      "#task/requirements": [
        "task/requirements/index.ts"
      ],
      "#conversation": [
        "conversation/index.ts"
      ],
      "#message": [
        "message/index.ts"
      ],
      "#dispatch": [
        "dispatch/index.ts"
      ],
      "#app": [
        "app/index.ts"
      ],
      "#socket": [
        "socket/index.ts"
      ],
      "#testing": [
        "testing/index.ts"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/__tests__",
    "dist"
  ],
  "references": []
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "paths": {
      "#transport": [
        "./src/transport/index.ts"
      ],
      "#transport/descriptor": [
        "./src/transport/descriptor.ts"
      ],
      "#identity": [
        "./src/identity/index.ts"
      ],
      "#identity/agents": [
        "./src/identity/agents/index.ts"
      ],
      "#identity/apps": [
        "./src/identity/apps/index.ts"
      ],
      "#identity/users": [
        "./src/identity/users/index.ts"
      ],
      "#identity/principals": [
        "./src/identity/principals/index.ts"
      ],
      "#identity/requirements": [
        "./src/identity/requirements/index.ts"
      ],
      "#network": [
        "./src/network/index.ts"
      ],
      "#conversation": [
        "./src/conversation/index.ts"
      ],
      "#conversation/requirements": [
        "./src/conversation/requirements/index.ts"
      ],
      "#message": [
        "./src/message/index.ts"
      ],
      "#message/dispatch": [
        "./src/message/dispatch.ts"
      ],
      "#socket": [
        "./src/socket/index.ts"
      ],
      "#socket/catalog": [
        "./src/socket/catalog/index.ts"
      ],
      "#testing": [
        "./src/testing/index.ts"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/__tests__",
    "dist"
  ],
  "references": []
}

{
  "name": "@moltzap/openclaw-channel",
  "version": "2026.1021.2",
  "description": "OpenClaw channel plugin for Social Harness messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git",
    "directory": "packages/openclaw-channel"
  },
  "homepage": "https://github.com/chughtapan/moltzap/tree/main/packages/openclaw-channel#readme",
  "bugs": {
    "url": "https://github.com/chughtapan/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/__tests__",
    "openclaw.plugin.json",
    "skills",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/openclaw-channel:build",
    "lint": "nx run @moltzap/openclaw-channel:lint",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-openclaw-package.ts"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "node ../../scripts/architecture/check-package.ts ."
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "openclaw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "sharnessContentHash": "sha256:19bfa4a1403915356574494411f7b7dd158349a3fb9c50889e841d54b2061673",
  "sharnessHostCodeHash": "sha256:e3856c9e39150570e7b5a7dc7b8c771244db183cf124056302441d7d59f176d8"
}

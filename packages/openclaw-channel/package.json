{
  "name": "@moltzap/openclaw-channel",
  "version": "2026.717.0",
  "description": "OpenClaw channel plugin for MoltZap messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/__tests__",
    "openclaw.plugin.json"
  ],
  "main": "./dist/openclaw-entry.js",
  "types": "./dist/openclaw-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/openclaw-entry.d.ts",
      "import": "./dist/openclaw-entry.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/openclaw-channel:build",
    "lint": "nx run @moltzap/openclaw-channel:lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:conformance": "vitest run -c vitest.conformance.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "eslint src *.ts --cache --max-warnings=0"
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@moltzap/client": "workspace:*",
    "@moltzap/protocol": "workspace:*",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "fast-check": "^3.23.1",
    "pg": "^8.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw-entry.js"
    ]
  }
}

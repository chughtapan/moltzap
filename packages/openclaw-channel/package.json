{
  "name": "@moltzap/openclaw-channel",
  "version": "2026.806.0",
  "description": "OpenClaw channel plugin for MoltZap messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/__tests__",
    "openclaw.plugin.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/openclaw-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/openclaw-channel:build",
    "lint": "nx run @moltzap/openclaw-channel:lint",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "tsc -b"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@moltzap/client": "workspace:*",
    "@moltzap/protocol": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "fast-check": "^3.23.1",
    "pg": "^8.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw-entry.js"
    ]
  }
}

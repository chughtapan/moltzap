{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@moltzap/evals",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/evals",
        "command": "node scripts/clean-dist.mjs && tsc -b"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/evals",
        "command": "eslint . --cache --max-warnings=0"
      }
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/evals",
        "command": "vitest run"
      }
    },
    "eval": {
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node packages/evals/dist/cli.js run"
      }
    },
    "resume": {
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node packages/evals/dist/cli.js resume"
      }
    },
    "calibrate": {
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node packages/evals/dist/cli.js calibrate"
      }
    },
    "publish": {
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node packages/evals/dist/cli.js publish"
      }
    },
    "typecheck:tests": {
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/evals",
        "command": "tsc -p tsconfig.test.json"
      }
    },
    "arch:check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/evals",
        "command": "node ../../scripts/architecture/check-package.mjs ."
      }
    }
  }
}

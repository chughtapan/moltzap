{
  "name": "@moltzap/testbed",
  "version": "2026.724.0",
  "description": "Testbed for launching and supervising collections of agents connected over MoltZap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/testbed:build",
    "lint": "nx run @moltzap/testbed:lint",
    "test": "vitest run --passWithNoTests",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/nanoclaw-channel/src/channels/moltzap.ts",
          "{projectRoot}/nanoclaw-assets/*"
        ],
        "options": {
          "cwd": "packages/testbed",
          "command": "tsc -b && node scripts/copy-nanoclaw-assets.mjs"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/testbed",
          "command": "eslint src *.ts --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/testbed",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@moltzap/openclaw-channel": "workspace:^",
    "@moltzap/protocol": "workspace:^",
    "effect": "^3.22.0",
    "openclaw": "2026.6.33"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

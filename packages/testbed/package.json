{
  "name": "@moltzap/testbed",
  "version": "2026.726.0",
  "description": "Testbed for launching and supervising collections of agents connected over MoltZap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/testbed:build",
    "lint": "tsc --build && eslint . --cache --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/nanoclaw-channel/src/channels/moltzap.ts",
          "{projectRoot}/nanoclaw-assets/*"
        ],
        "options": {
          "cwd": "packages/testbed",
          "command": "tsc -b && node scripts/copy-nanoclaw-assets.mjs"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/testbed",
          "command": "pnpm lint"
        }
      },
      "test:integration": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "MOLTZAP_NANOCLAW_ITEST"
          },
          {
            "env": "MOLTZAP_OPENCLAW_ITEST"
          }
        ]
      },
      "typecheck:tests": {
        "dependsOn": [
          "build"
        ]
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/testbed",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@moltzap/openclaw-channel": "workspace:^",
    "@moltzap/protocol": "workspace:^",
    "effect": "^3.22.0",
    "openclaw": "2026.6.33"
  },
  "devDependencies": {
    "@moltzap/client": "workspace:*",
    "@moltzap/server-core": "workspace:*",
    "@types/node": "^25.5.0",
    "eslint": "^9",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

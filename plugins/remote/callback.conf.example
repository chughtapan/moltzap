# Install inside an existing TLS server on the authorized remote host.
# Preserve this exact path and query when proxying; never expose MCP/management.
location = /moltzap/events {
    limit_except POST { deny all; }
    client_max_body_size 256k;
    client_body_timeout 4s;
    proxy_connect_timeout 1s;
    proxy_send_timeout 4s;
    proxy_read_timeout 4s;
    proxy_request_buffering on;
    proxy_pass http://127.0.0.1:4318;
    access_log off;
}

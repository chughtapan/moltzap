# Non-secret configuration for an authorized remote VM, never a user's computer.
# Copy to /etc/moltzap/native-receiver.env and fill the verified native values.
# This example intentionally cannot activate a provider until setup is complete.
MOLTZAP_NATIVE_PLATFORM=instinct
MOLTZAP_MCP_URL=http://127.0.0.1:7301/mcp
MOLTZAP_MCP_CREDENTIAL_FILE=/run/moltzap/runtime/mcp-runtime-credential
MOLTZAP_NATIVE_WEBHOOK_URL=https://REPLACE_WITH_VERIFIED_CALLBACK_HOST/moltzap/events
MOLTZAP_NATIVE_WEBHOOK_PORT=4318

# Instinct only: existing dedicated AgentMail sender and verified native recipient.
MOLTZAP_AGENTMAIL_KEY_FILE=/etc/moltzap/secrets/agentmail-key
MOLTZAP_AGENTMAIL_INBOX_ID=REPLACE_WITH_EXISTING_AGENTMAIL_INBOX
MOLTZAP_INSTINCT_EMAIL=REPLACE_WITH_VERIFIED_INSTINCT_RECIPIENT

# Grok only: switch platform above to grokbot and use an owner-approved routine.
MOLTZAP_GROK_ROUTINE_URL=https://REPLACE_WITH_APPROVED_ROUTINE_URL
MOLTZAP_GROK_ROUTINE_KEY_FILE=/etc/moltzap/secrets/grok-routine-key

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "two-agents-example",
  "targets": {
    "test:pack": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build",
        {
          "target": "build",
          "projects": [
            "@moltzap/registry"
          ]
        }
      ],
      "cache": false,
      "options": {
        "cwd": ".",
        "command": "node scripts/test-two-agents-example.ts"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/registry/src/**/*"
      ]
    }
  }
}

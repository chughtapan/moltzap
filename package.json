{
  "name": "moltzap",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r run test:integration",
    "lint": "eslint packages/ && oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "//typecheck": "TODO(#286 B.5 / Phase 1.4): drop the '!./examples/**' filter and re-include examples once @moltzap/app-sdk handler surface + lifecycle methods land. See chughtapan/moltzap#294.",
    "typecheck": "pnpm -r --filter '!./examples/**' exec tsc --noEmit",
    "check": "pnpm lint && pnpm format:check",
    "test:conformance:toxiproxy": "bash scripts/conformance-toxiproxy.sh",
    "test:conformance:stress": "CONFORMANCE_STRESS=1 bash scripts/conformance-toxiproxy.sh",
    "docs": "cd docs && mint dev",
    "docs:generate": "cd packages/protocol && npx tsx ../../scripts/generate-protocol-docs.ts",
    "docs:check": "cd docs && mint broken-links",
    "docs:check:drift": "cd packages/protocol && npx tsx ../../scripts/generate-protocol-docs.ts && cd ../.. && git diff --exit-code docs/protocol/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.5",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fast-check": "^4.0.0",
    "husky": "^9.0.0",
    "mint": "^4.0.0",
    "oxfmt": "^0.7.0",
    "oxlint": "^0.16.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@anthropic-ai/claude-code"
    ]
  }
}

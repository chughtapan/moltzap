{
  "name": "moltzap",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test:integration",
    "lint": "node scripts/check-architecture-boundaries.js && pnpm arch:config:check && pnpm arch:check && agent-code-guard-knip --treat-config-hints-as-errors && eslint *.ts --cache --max-warnings=0 && nx run-many -t lint && oxlint . --deny-warnings",
    "arch:check": "NODE_OPTIONS=--max-old-space-size=8192 nx run-many -t arch:check",
    "arch:config:generate": "node scripts/gen-architecture-configs.mjs",
    "arch:config:check": "pnpm arch:config:generate && git diff --exit-code -- 'packages/*/safer-architecture.config.json'",
    "lint:root": "agent-code-guard-knip --treat-config-hints-as-errors && eslint *.ts --cache --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "nx run-many -t build",
    "check": "pnpm lint && pnpm format:check",
    "test:conformance:toxiproxy": "bash scripts/conformance-toxiproxy.sh",
    "test:conformance:stress": "CONFORMANCE_STRESS=1 bash scripts/conformance-toxiproxy.sh",
    "docs": "cd docs && mint dev",
    "docs:generate": "pnpm --filter @moltzap/protocol docs:generate && pnpm --filter @moltzap/client docs:generate && pnpm --filter @moltzap/server-core exec tsx ../../scripts/generate-constants-snippets.ts",
    "docs:check": "cd docs && mint broken-links",
    "docs:check:drift": "pnpm docs:generate && git diff --exit-code docs/ 'packages/**/MODULE.md' README.md && pnpm docs:check:no-hardcoded-constants && pnpm docs:check:doc-imports-resolve",
    "docs:check:mermaid": "pnpm --filter @moltzap/protocol exec tsx scripts/check-mermaid.ts",
    "docs:check:no-hardcoded-constants": "pnpm --filter @moltzap/server-core exec tsx ../../scripts/check-no-hardcoded-constants.ts",
    "docs:check:doc-imports-resolve": "pnpm --filter @moltzap/server-core exec tsx ../../scripts/check-doc-imports-resolve.ts",
    "docs:check:gates-test": "pnpm --filter @moltzap/server-core exec tsx ../../scripts/__tests__/gates.test.ts",
    "prepare": "husky",
    "effect:source": "./scripts/prepare-effect.sh",
    "test:affected": "nx affected -t test",
    "evals": "pnpm build && cc-judge run packages/evals/scenarios --results ./eval-results"
  },
  "devDependencies": {
    "@chughtapan/safer-architecture-lsp": "0.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@moltzap/cc-judge": "0.0.3",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "husky": "^9.0.0",
    "mint": "^4.0.0",
    "nx": "^22.7.5",
    "oxfmt": "^0.7.0",
    "oxlint": "^0.16.0",
    "typedoc": "^0.28.19",
    "typescript": "^5"
  }
}

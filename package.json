{
  "name": "moltzap",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "lint": "agent-code-guard-knip --treat-config-hints-as-errors && eslint scripts/**/*.ts *.ts --cache --max-warnings=0 && pnpm -r --workspace-concurrency=1 lint && oxlint . --deny-warnings",
    "lint:root": "agent-code-guard-knip --treat-config-hints-as-errors && eslint scripts/**/*.ts *.ts --cache --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "check": "pnpm lint && pnpm format:check",
    "test:conformance:toxiproxy": "bash scripts/conformance-toxiproxy.sh",
    "test:conformance:stress": "CONFORMANCE_STRESS=1 bash scripts/conformance-toxiproxy.sh",
    "docs": "cd docs && mint dev",
    "docs:generate": "pnpm --filter @moltzap/protocol docs:generate",
    "docs:check": "cd docs && mint broken-links",
    "docs:check:drift": "pnpm docs:generate && git diff --exit-code docs/protocol/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9",
    "eslint-plugin-agent-code-guard": "0.0.14",
    "husky": "^9.0.0",
    "mint": "^4.0.0",
    "oxfmt": "^0.7.0",
    "oxlint": "^0.16.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@anthropic-ai/claude-code"
    ]
  }
}

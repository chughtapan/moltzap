{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/protocol",
    "packages/server",
    "packages/client",
    "packages/runtimes",
    "packages/claude-code-channel",
    "packages/nanoclaw-channel",
    "packages/openclaw-channel"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "excludeInternal": true,
    "excludePrivate": true,
    "readme": "none",
    "skipErrorChecking": true,
    "outputs": [
      { "name": "json", "path": "node_modules/.cache/typedoc-pkg.json" }
    ],
    "blockTags": [
      "@file",
      "@failure",
      "@error",
      "@param",
      "@returns",
      "@throws",
      "@example",
      "@deprecated",
      "@see",
      "@remarks",
      "@internal",
      "@since",
      "@module",
      "@relatedNotification",
      "@triggeredBy"
    ]
  },
  "outputs": [
    { "name": "json", "path": "node_modules/.cache/typedoc.json" }
  ],
  "readme": "none",
  "skipErrorChecking": true,
  "logLevel": "Warn"
}

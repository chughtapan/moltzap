{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@moltzap/openclaw-channel": [
        "../packages/openclaw-channel/src/index.ts"
      ]
    },
    "customConditions": [
      "sharness-test"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}

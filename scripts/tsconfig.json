{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "__tests__",
    "docs",
    "repo",
    "test/adapter-daemon-process.integration.test.ts",
    "test/adapter-daemon-vitest.config.ts"
  ]
}
